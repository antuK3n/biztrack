meta {
  name: Upload Document
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/applications/1/documents
  body: multipartForm
  auth: inherit
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:multipart-form {
  document_type_id: 1
}

docs {
  Multipart form-data. Fields: document_type_id (int), file (pdf/jpg/jpeg/png <= 10MB). Set the file in the Bruno UI.
}
