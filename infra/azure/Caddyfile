# HTTPS for biztrack.page. Caddy gets and renews the Let's Encrypt certificate
# on its own; nothing to paste, nothing to expire.
{
	email {$ACME_EMAIL}
}

biztrack.page {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:80
}

www.biztrack.page {
	redir https://biztrack.page{uri} permanent
}
