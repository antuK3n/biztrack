    "rulebook": [
        {
            "rule": "expiry",
            "label": "Time to expiry",
            "max": 30,
            "description": "Stepped on the expiry-monitoring marks \u2014 30, 15, 7 and 1 day out. Full weight once the permit has lapsed or expires tomorrow, nothing beyond 90 days out."
        },
        {
            "rule": "progress",
            "label": "Renewal progress",
            "max": 25,
            "description": "Full weight when a renewal is due within 30 days and none has been filed, or when one was rejected and must be refiled. A permit not yet due scores nothing here, and neither does one already renewed."
        },
        {
            "rule": "punctuality",
            "label": "Past punctuality",
            "max": 20,
            "description": "The share of this business's earlier renewals filed after the old permit expired. A first renewal cycle has no record and takes half weight."
        },
        {
            "rule": "findings",
            "label": "Open compliance findings",
            "max": 15,
            "description": "Unticked requirements and failed or conditional inspections that would block issuance even on a punctual filing."
        },
        {
            "rule": "fees",
            "label": "Unsettled fees",
            "max": 10,
            "description": "An assessed fee with no completed payment against it."
