<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suite as phpunit.xml, run against PostgreSQL 16 — the engine
    production uses (Azure Database for PostgreSQL, Flexible Server).

        php artisan test -c phpunit.pgsql.xml

    phpunit.xml pins SQLite in memory, which is right for day-to-day work and
    wrong for proving the queries run where they will be deployed: SQLite
    accepts things PostgreSQL refuses (loose GROUP BY, strftime, comparing a
    text column to an integer). docs/postgres.md says how to raise a throwaway
    server; the connection below matches it.

    DB_CONNECTION is forced so a stray shell or .env value cannot send this run
    to SQLite. The rest are defaults: set DB_HOST, DB_PORT, DB_DATABASE,
    DB_USERNAME or DB_PASSWORD in the shell to point elsewhere. The database is
    wiped by RefreshDatabase — never point it at one that holds anything.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- See phpunit.xml: dompdf's resident font cache needs the room. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="biztrack_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
