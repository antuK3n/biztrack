# keep the image build context lean + never ship host artifacts
api/vendor
api/node_modules
api/storage/logs/*
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/database/database.sqlite
api/.env
web/node_modules
web/dist
mobile
r
prototype-pages
bt-figma-shots
bt-board
rehaul-check
*.pdf
*.png

# Secrets and data never go into an image. The server's api/.env.production is
# handed to the containers at run time (env_file), not baked into a layer.
api/.env.*
!api/.env.example
api/database/*.sqlite
api/database/*.sqlite-*
api/storage/app/*
web/.env
web/.env.*
.git
.claude
.planning
graphify-out
